       <xsd:documentation>Indicates whether to enable preferences for Waitlist Management.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
    <xsd:attribute name="fqn" type="xsd:string"/>
   </xsd:extension>
  </xsd:complexContent>

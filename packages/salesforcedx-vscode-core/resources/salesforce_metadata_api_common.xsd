  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="FilesConnectSettings">
  <xsd:annotation>
   <xsd:documentation>Represents the settings that modify the Files Connect feature.This type extends the Metadata metadata type and inherits its fullName field.</xsd:documentation>

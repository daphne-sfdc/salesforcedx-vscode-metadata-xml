       <xsd:appinfo>Type: string</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
    <xsd:attribute name="fqn" type="xsd:string"/>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ValueSetValuesDefinition">
  <xsd:annotation>
   <xsd:documentation>These field types extend the field types described in the Salesforce Object Reference.</xsd:documentation>

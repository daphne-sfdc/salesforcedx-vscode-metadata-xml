       <xsd:documentation>One or more of the picklist values in the picklist. Each value defined is available in the record type that contains this component.</xsd:documentation>
       <xsd:appinfo>Type: PicklistValue</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
    </xsd:choice>
    <xsd:attribute name="fqn" type="xsd:string"/>
   </xsd:extension>
  </xsd:complexContent>
 </xsd:complexType>
 <xsd:complexType name="ReportTypeColumnTranslation">

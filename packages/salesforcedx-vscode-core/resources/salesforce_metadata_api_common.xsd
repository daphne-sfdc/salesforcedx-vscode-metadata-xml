     </xsd:element>
     <xsd:element name="enableTrialManagementRandomization" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether Research Study Randomization is enabled for your org (true) or not (false). Using this feature, users can design and run randomization procedures for their clinical trials. The default value is false. Available in API version 61.0 and later.</xsd:documentation>
       <xsd:appinfo>Type: boolean</xsd:appinfo>
      </xsd:annotation>
     </xsd:element>
     <xsd:element name="enableVisitInventoryEnabled" minOccurs="0" maxOccurs="unbounded" type="xsd:boolean">
      <xsd:annotation>
       <xsd:documentation>Indicates whether to enable inventory tracking for visits.</xsd:documentation>
